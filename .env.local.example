# 実際の会社名・代表者名・住所・電話番号・資格情報が確定し、
# オーナー本人の同意が取れたら、このファイルをコピーして .env.local を作り、
# りん自身が直接値を書き込むこと。
# .env.local は .gitignore 対象（Git管理外）。Claude Codeにこの中身を読ませないこと。
#
# cp .env.local.example .env.local

NEXT_PUBLIC_SHOP_NAME=
NEXT_PUBLIC_OWNER_NAME=
NEXT_PUBLIC_SHOP_PHONE=
NEXT_PUBLIC_SHOP_ADDRESS=
# 資格情報は任意項目。無ければ空のままでよい
NEXT_PUBLIC_QUALIFICATIONS=
